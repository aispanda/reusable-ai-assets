# Complete with your own isolated environment. No default Admin or credentials.
# PUBLIC_SITE_ORIGIN must be the exact canonical origin, not an arbitrary Host header.
PORT=8080
PUBLIC_SITE_ORIGIN=https://journal.example
RUNTIME_ENVIRONMENT=staging
GOOGLE_CLOUD_PROJECT=
RUNTIME_FIREBASE_API_KEY=
RUNTIME_FIREBASE_AUTH_DOMAIN=
RUNTIME_FIREBASE_PROJECT_ID=
RUNTIME_FIREBASE_STORAGE_BUCKET=
RUNTIME_FIREBASE_MESSAGING_SENDER_ID=
RUNTIME_FIREBASE_APP_ID=
RUNTIME_GOOGLE_CLIENT_ID=
# Optional consumer-owned legacy collection profile; omit for an empty registry.
# BLOG_COLLECTION_PROFILE=/absolute/path/to/collection-profile.json
# Production uses the platform's service identity; never package its credentials.
# Emulator tests set demo-only configuration themselves and cannot use live projects.
