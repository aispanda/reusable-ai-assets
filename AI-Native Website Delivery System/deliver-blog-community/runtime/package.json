{
  "name": "@reusable/blog-community-runtime",
  "version": "0.2.0-rc.8",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "astro build",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "test": "node --test tests/content-publishing.test.mjs tests/runtime-config.test.mjs tests/studio-content-document.test.mjs tests/studio-content-assets.test.mjs tests/studio-editor-ui.test.mjs tests/studio-youtube.test.mjs tests/runtime-startup.test.mjs tests/site-profile.test.mjs tests/collection-input.test.mjs tests/collection-regressions.test.mjs tests/public-collections.test.mjs tests/sign-in-navigation.test.mjs tests/staging-preflight.test.mjs",
    "test:media": "node --test tests/studio-media-browser.test.mjs tests/studio-private-preview-images.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-blog-community \"node --test tests/community-rules.test.mjs tests/firestore-rules.test.mjs\"",
    "test:scenarios": "firebase emulators:exec --only auth,firestore --project demo-blog-community \"node tests/scenarios.test.mjs\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-blog-community \"node --test tests/http-lifecycle.test.mjs\"",
    "test:collections": "firebase emulators:exec --only auth,firestore --project demo-blog-collections \"node --test tests/collection-http.test.mjs\"",
    "test:editorial": "firebase emulators:exec --only firestore --project demo-blog-community \"node --test tests/editorial-workflow.test.mjs\""
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tiptap/core": "3.30.3",
    "@tiptap/extension-link": "3.30.3",
    "@tiptap/html": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "astro": "7.2.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.5.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.62.1",
    "firebase-tools": "15.28.1"
  }
}
