---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Comments from '@/components/Comments.astro';
---

<BaseLayout title="@@BLOG_ARTICLE_TITLE@@" description="@@BLOG_ARTICLE_DESCRIPTION@@" canonicalHref="@@BLOG_ARTICLE_URL@@">
  <article class="insight-article">
    <div class="shell insight-layout">
      <div class="insight-main">
        <header class="insight-hero">
          <div class="insight-hero-meta">
            <p class="eyebrow">Insight · @@BLOG_ARTICLE_READ_TIME@@</p>
            <a
              class="insight-edit"
              href="/studio?draft=@@BLOG_ARTICLE_DRAFT_ID@@"
              data-local-edit
              hidden
            >Edit article</a>
            <a class="insight-back" href="/">← All articles</a>
          </div>
          <h1>@@BLOG_ARTICLE_TITLE@@</h1>
          <p class="lede">@@BLOG_ARTICLE_DESCRIPTION@@</p>
        </header>

        <section class="content-card insight-body">
          <div class="insight-prose">@@BLOG_ARTICLE_BODY@@</div>
        </section>

        <!--@@BLOG_INTERACTIVE_START@@-->
        <Comments articleSlug="@@BLOG_ARTICLE_SLUG@@" />
        <!--@@BLOG_INTERACTIVE_END@@-->
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { enhanceInsightTables } from '@/scripts/enhance-insight-tables';
  enhanceInsightTables();

  const sessionKey = 'blog-studio-authorized-session-v1';
  const editLink = document.querySelector<HTMLElement>('[data-local-edit]');
  const refreshEditAccess = () => {
    let authorized = false;
    try {
      const session = JSON.parse(window.localStorage.getItem(sessionKey) ?? '{}') as { role?: string; expiresAt?: number };
      authorized = ['administrator', 'publisher', 'author'].includes(session.role ?? '')
        && Number(session.expiresAt) > Date.now();
    } catch {
      authorized = false;
    }
    if (editLink) editLink.hidden = !authorized;
  };
  refreshEditAccess();
  window.addEventListener('storage', (event) => {
    if (event.key === sessionKey) refreshEditAccess();
  });
</script>

<style>
  .insight-layout { grid-template-columns: minmax(0, 1fr); }
  .insight-main { width: min(900px, 100%); margin-inline: auto; }
  .insight-edit {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--blue);
    font-size: .85rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  .insight-edit:hover { text-decoration: underline; text-underline-offset: .18em; }
  .insight-edit + .insight-back { margin-left: .9rem; }
</style>
