    <dialog class="studio-dialog studio-access-dialog" data-access-dialog aria-labelledby="studio-access-review-title">
      <div class="studio-dialog-header">
        <div>
          <p class="studio-kicker">Administrator review</p>
          <h2 id="studio-access-review-title">Access requests</h2>
        </div>
        <button class="studio-icon-button" type="button" data-close-access aria-label="Close access requests">×</button>
      </div>
      <p class="studio-access-dialog-summary">Review each application before granting its requested role. Declining a request leaves the person's existing access unchanged.</p>
      <div class="studio-access-request-list" data-access-request-list aria-live="polite"></div>
    </dialog>

    <dialog class="studio-dialog studio-link-dialog" data-link-dialog aria-labelledby="studio-link-title">
      <form data-link-form>
        <div class="studio-dialog-header">
          <div>
            <p class="studio-kicker">Text link</p>
            <h2 id="studio-link-title">Add or edit link</h2>
          </div>
          <button class="studio-icon-button" type="button" data-close-link aria-label="Close link editor">×</button>
        </div>
        <div class="studio-link-content">
          <label>
            <span>Web or email address</span>
            <input type="text" inputmode="url" autocomplete="url" placeholder="https://example.com" data-link-url />
          </label>
          <p>Use a complete web address, email link, or a domain such as example.com. Unsafe link types are blocked.</p>
        </div>
        <div class="studio-link-actions">
          <button class="studio-button studio-button-secondary" type="button" data-remove-link hidden>Remove link</button>
          <span></span>
          <button class="studio-button studio-button-secondary" type="button" data-close-link>Cancel</button>
          <button class="studio-button" type="submit">Apply link</button>
        </div>
      </form>
    </dialog>

    <dialog class="studio-dialog studio-image-dialog" data-image-dialog aria-labelledby="studio-image-title">
      <form data-image-form>
        <div class="studio-dialog-header">
          <div>
            <p class="studio-kicker">Article image</p>
            <h2 id="studio-image-title" data-image-dialog-title>Insert image</h2>
          </div>
          <button class="studio-icon-button" type="button" data-close-image aria-label="Close image editor">×</button>
        </div>
        <div class="studio-image-content">
          <label>
            <span>Image file <small>PNG, JPEG, or WebP · maximum 5 MB</small></span>
            <input type="file" accept="image/png,image/jpeg,image/webp" data-image-file />
          </label>
          <label>
            <span>Alternative text</span>
            <input type="text" maxlength="500" placeholder="Describe what the image communicates" data-image-alt />
          </label>
          <label class="studio-image-decorative">
            <input type="checkbox" data-image-decorative />
            <span><strong>This image is decorative</strong><small>Screen readers will skip it. Use only when the image adds no information.</small></span>
          </label>
          <label>
            <span>Caption <small>Optional</small></span>
            <textarea rows="3" maxlength="1000" placeholder="Context shown below the image" data-image-caption></textarea>
          </label>
          <label>
            <span>Image credit (optional)</span>
            <input type="text" maxlength="500" placeholder="Photographer, illustrator, or source" data-image-credit />
            <small>Shown below the image. Clear this field to remove the credit.</small>
          </label>
          <p class="studio-image-status" role="status" aria-live="polite" data-image-status></p>
        </div>
        <div class="studio-image-actions">
          <button class="studio-button studio-button-secondary" type="button" data-close-image>Cancel</button>
          <button class="studio-button" type="submit" data-submit-image>Upload and insert</button>
