---
import '@/styles/global.css';
import '@/styles/article-layouts.css';
import site from '@/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>My articles · {site.siteName}</title>
  </head>
  <body class="studio-page">
    <section class="studio-access-gate" data-access-gate data-access-pending aria-busy="true" aria-labelledby="studio-access-title">
      <div class="studio-access-card">
        <a class="studio-access-brand" href="/" aria-label={`${site.siteName} home`}>
          <span>{site.siteName}</span>
        </a>
        <p class="studio-kicker">Private content workspace</p>
        <h1 id="studio-access-title" data-access-title>Opening your workspace…</h1>
        <p data-access-message>Restoring your editorial session.</p>
        <div class="studio-access-actions">
          <button class="studio-google-button" type="button" data-google-signin hidden>
            <span aria-hidden="true">G</span>
            Continue with Google
          </button>
          <button class="studio-button studio-button-secondary" type="button" data-access-retry hidden>Use another account</button>
        </div>
        <form class="studio-profile-form" data-profile-form hidden>
          <p>Signed in as <strong data-profile-email></strong></p>
          <label>
            <span>Professional role</span>
            <select data-profile-professional-role>
              <option value="prefer-not-to-say">Prefer not to say</option>
              <option value="student">Student</option>
              <option value="educator-researcher">Educator or researcher</option>
              <option value="technology-ai-practitioner">Technology or AI practitioner</option>
              <option value="business-operations-leader">Business or operations leader</option>
              <option value="public-sector-policy">Public sector or policy</option>
              <option value="writer-creator">Writer or creator</option>
              <option value="independent-learner">Independent learner</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>
            <span>Primary interest</span>
            <select data-profile-primary-interest>
              <option value="prefer-not-to-say">Prefer not to say</option>
              <option value="practical-ai">Practical AI use</option>
              <option value="ai-strategy">AI strategy and leadership</option>
              <option value="open-reusable-ai">Open and reusable AI</option>
              <option value="ai-policy-social-impact">AI policy and social impact</option>
              <option value="education-training">Education and training</option>
              <option value="community-discussion">Community and discussion</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>
            <span>Country or area</span>
            <select data-profile-country>
              <option value="">Prefer not to say</option>
            </select>
          </label>
          <small>These choices help us understand our community. They do not change your account permissions.</small>
          <button class="studio-button" type="submit" data-profile-submit>Continue</button>
          <small role="status" aria-live="polite" data-profile-status></small>
        </form>
        <div class="studio-role-request" data-role-request-panel hidden>
          <p>Signed in as <strong data-role-request-email></strong></p>
          <label>
            <span>Request editorial access</span>
            <select data-role-request-select>
              <option value="author">Author</option>
              <option value="publisher">Publisher</option>
            </select>
          </label>
          <div class="studio-role-request-actions">
            <button class="studio-button" type="button" data-role-request-submit>Send request</button>
            <button class="studio-button studio-button-secondary" type="button" data-role-request-cancel hidden>Cancel request</button>
          </div>
          <small role="status" aria-live="polite" data-role-request-status>Only an existing administrator can approve this request.</small>
        </div>
        <a class="studio-button studio-button-secondary studio-back-home" href="/">Back to {site.siteName}</a>
        <small>New accounts start as Commentators. Editorial access requires Administrator approval.</small>
      </div>
    </section>

    <main class="studio" data-studio hidden>
      <aside class="studio-sidebar" aria-label="Content navigation">
        <a class="studio-brand" href="/" aria-label={`${site.siteName} home`}>
          <span>{site.siteName}</span>
        </a>

        <button class="studio-new-article" type="button" data-new-article disabled>
          <span aria-hidden="true">＋</span> New article
        </button>

        <div>
          <p class="studio-kicker">Content</p>
          <nav class="studio-nav">
            <button class="is-active" type="button" data-filter="all"><span>All statuses</span><small data-all-count>1</small></button>
            <button type="button" data-filter="draft"><span>Drafts</span><small data-draft-count>0</small></button>
            <button type="button" data-filter="published"><span>Published</span><small data-published-count>1</small></button>
            <button type="button" data-filter="unpublished"><span>Unpublished</span><small data-unpublished-count>0</small></button>
            <button type="button" data-filter="archived"><span>Trash</span><small data-archived-count>0</small></button>
          </nav>
        </div>

        <div class="studio-document-list">
          <p class="studio-kicker" data-list-heading>My articles</p>
          <div class="studio-document-items" data-document-list></div>
        </div>

        <div class="studio-sidebar-note">
          <strong>Publishing</strong>
          <span data-persistence-note>Drafts save to your account and publish directly to the site.</span>
        </div>

        <div class="studio-account" data-studio-account hidden>
          <span>Signed in as</span>
          <strong data-studio-account-email></strong>
          <span class="studio-account-role" data-studio-account-role></span>
          <a href="/account">Account settings</a>
          <button type="button" data-manage-access hidden>Access requests</button>
          <button type="button" data-studio-signout>Sign out</button>
        </div>
      </aside>

      <section class="studio-workspace">
        <header class="studio-topbar">
          <details class="studio-mobile-nav">
            <summary aria-label="Open content navigation">☰</summary>
            <nav aria-label="Mobile content navigation">
              <button type="button" data-filter="all">All statuses</button>
              <button type="button" data-filter="draft">Drafts</button>
              <button type="button" data-filter="published">Published</button>
              <button type="button" data-filter="unpublished">Unpublished</button>
              <button type="button" data-filter="archived">Trash</button>
              <button type="button" data-new-article disabled>New article</button>
              <a href="/account">Account settings</a>
              <button type="button" data-studio-signout>Sign out</button>
            </nav>
          </details>
          <div>
            <a class="studio-mobile-brand" href="/">{site.siteName}</a>
            <p class="studio-kicker" data-topbar-kicker>Article</p>
            <p class="studio-save-state" role="status" aria-live="polite" data-save-state>Draft · ready</p>
          </div>

          <div class="studio-actions" data-editor-actions>
            <button class="studio-button" type="button" data-submit-review hidden>Submit for review</button>
            <button class="studio-button studio-button-secondary" type="button" data-withdraw-review hidden>Withdraw submission</button>
            <button class="studio-button studio-button-secondary" type="button" data-return-review hidden>Return with feedback</button>
            <button class="studio-button studio-button-secondary" type="button" data-migrate-draft hidden>Convert to professional editor</button>
            <button class="studio-button studio-button-secondary" type="button" data-save-draft>Save checkpoint</button>
            <button class="studio-button studio-button-secondary" type="button" data-preview>Preview</button>
            <button class="studio-button" type="button" data-open-publish>Publish</button>
          </div>
        </header>

        <div class="studio-grid" data-editor-workspace inert aria-busy="true">
          <section class="studio-editor-column" aria-label="Article editor">
            <div class="studio-toolbar" role="toolbar" aria-label="Article formatting" aria-controls="studio-article-body" data-toolbar>
              <label class="studio-toolbar-style">
                <span>Style</span>
                <select data-text-style data-toolbar-roving aria-label="Text style" title="Choose paragraph or heading style">
                  <option value="paragraph">Paragraph</option>
                  <option value="h2">Heading 2</option>
                  <option value="h3">Heading 3</option>
                </select>
              </label>

              <button type="button" data-editor-action="bold" data-toolbar-roving aria-label="Bold" aria-keyshortcuts="Control+B Meta+B" aria-pressed="false" title="Bold (Ctrl or Cmd + B)"><strong aria-hidden="true">B</strong></button>
              <button type="button" data-editor-action="italic" data-toolbar-roving aria-label="Italic" aria-keyshortcuts="Control+I Meta+I" aria-pressed="false" title="Italic (Ctrl or Cmd + I)"><em aria-hidden="true">I</em></button>
              <button class="studio-toolbar-primary-link" type="button" data-editor-action="link" data-toolbar-roving aria-label="Add or edit link" aria-keyshortcuts="Control+K Meta+K" aria-pressed="false" title="Add or edit link (Ctrl or Cmd + K)"><span aria-hidden="true">↗</span><span class="studio-toolbar-label">Link</span></button>

              <span class="studio-toolbar-separator studio-toolbar-wide" aria-hidden="true"></span>
              <button class="studio-toolbar-wide" type="button" data-editor-action="bulletList" data-toolbar-roving aria-label="Bulleted list" aria-pressed="false" title="Bulleted list"><span aria-hidden="true">•</span><span>Bullets</span></button>
              <button class="studio-toolbar-wide" type="button" data-editor-action="orderedList" data-toolbar-roving aria-label="Numbered list" aria-pressed="false" title="Numbered list"><span aria-hidden="true">1.</span><span>Numbering</span></button>
              <button class="studio-toolbar-wide studio-toolbar-icon-only" type="button" data-editor-action="liftListItem" data-toolbar-roving aria-label="Decrease list indent" title="Decrease list indent"><span aria-hidden="true">⇤</span></button>
              <button class="studio-toolbar-wide studio-toolbar-icon-only" type="button" data-editor-action="sinkListItem" data-toolbar-roving aria-label="Increase list indent" title="Increase list indent"><span aria-hidden="true">⇥</span></button>
              <button class="studio-toolbar-wide" type="button" data-editor-action="blockquote" data-toolbar-roving aria-label="Quote" aria-pressed="false" title="Quote"><span aria-hidden="true">“</span><span>Quote</span></button>

              <details class="studio-toolbar-menu studio-toolbar-wide" data-toolbar-menu>
                <summary data-toolbar-roving aria-label="Insert content" title="Insert content"><span aria-hidden="true">＋</span><span>Insert</span></summary>
                <div class="studio-toolbar-menu-items">
                  <button type="button" data-editor-action="image"><span aria-hidden="true">▧</span><span><strong>Image</strong><small>Upload with alt text</small></span></button>
                  <button type="button" data-editor-action="youtube"><span aria-hidden="true">▶</span><span><strong>YouTube video</strong><small>Click-to-load player</small></span></button>
                  <button type="button" data-editor-action="callout"><span aria-hidden="true">▣</span><span><strong>Callout</strong><small>Highlighted note</small></span></button>
                  <button type="button" data-editor-action="horizontalRule"><span aria-hidden="true">―</span><span><strong>Divider</strong><small>Section break</small></span></button>
                </div>
              </details>

              <span class="studio-toolbar-separator studio-toolbar-wide" aria-hidden="true"></span>
              <button class="studio-toolbar-wide studio-toolbar-icon-only" type="button" data-editor-action="undo" data-toolbar-roving aria-label="Undo" aria-keyshortcuts="Control+Z Meta+Z" title="Undo (Ctrl or Cmd + Z)"><span aria-hidden="true">↶</span></button>
              <button class="studio-toolbar-wide studio-toolbar-icon-only" type="button" data-editor-action="redo" data-toolbar-roving aria-label="Redo" title="Redo"><span aria-hidden="true">↷</span></button>

              <details class="studio-toolbar-menu studio-toolbar-more" data-toolbar-menu>
                <summary data-toolbar-roving aria-label="More formatting options" title="More formatting options"><span aria-hidden="true">•••</span><span class="studio-toolbar-more-label">More</span></summary>
                <div class="studio-toolbar-menu-items">
                  <button type="button" data-editor-action="bulletList" aria-pressed="false"><span aria-hidden="true">•</span><span>Bulleted list</span></button>
                  <button type="button" data-editor-action="orderedList" aria-pressed="false"><span aria-hidden="true">1.</span><span>Numbered list</span></button>
                  <button type="button" data-editor-action="liftListItem"><span aria-hidden="true">⇤</span><span>Decrease list indent</span></button>
                  <button type="button" data-editor-action="sinkListItem"><span aria-hidden="true">⇥</span><span>Increase list indent</span></button>
                  <button type="button" data-editor-action="blockquote" aria-pressed="false"><span aria-hidden="true">“</span><span>Quote</span></button>
                  <button type="button" data-editor-action="image"><span aria-hidden="true">▧</span><span>Insert image</span></button>
                  <button type="button" data-editor-action="youtube"><span aria-hidden="true">▶</span><span>Insert or edit YouTube video</span></button>
                  <button type="button" data-editor-action="callout"><span aria-hidden="true">▣</span><span>Insert callout</span></button>
                  <button type="button" data-editor-action="horizontalRule"><span aria-hidden="true">―</span><span>Insert divider</span></button>
                  <button type="button" data-editor-action="undo"><span aria-hidden="true">↶</span><span>Undo</span></button>
                  <button type="button" data-editor-action="redo"><span aria-hidden="true">↷</span><span>Redo</span></button>
                </div>
              </details>
            </div>

            <div class="studio-image-context" role="group" aria-label="Selected image" data-image-tools hidden>
              <strong>Image selected</strong>
              <button type="button" data-edit-image>Edit or replace</button>
              <button type="button" data-remove-image>Remove</button>
            </div>

            <article class="studio-paper">
              <label class="studio-title-label" for="studio-article-title">Article title</label>
              <textarea id="studio-article-title" class="studio-title" rows="2" aria-label="Article title" aria-describedby="studio-title-help" placeholder="Enter your article title" required data-title></textarea>
              <p id="studio-title-help" class="studio-title-help">This title appears in your content list and published article. A heading in the body does not set the title.</p>
              <p class="studio-byline"><span data-read-time>1 min read</span></p>
              <div id="studio-article-body" class="studio-prose insight-prose" data-editor>
                <p></p>
              </div>
            </article>

            <footer class="studio-editor-footer">
              <span data-word-count>0 words</span>
              <span>Changes autosave to the cloud</span>
            </footer>
          </section>

          <aside class="studio-inspector" aria-label="Article settings">
            <div class="studio-inspector-heading">
              <div>
                <p class="studio-kicker">Settings</p>
                <h2>Publication details</h2>
              </div>
              <span class="studio-badge" data-publication-badge>Draft</span>
            </div>

            <label>
              <span>Article title</span>
              <input type="text" aria-label="Article title in settings" placeholder="Enter your article title" required data-settings-title />
              <small>Same title as the editor and content list.</small>
            </label>

            <label>
              <span>URL slug</span>
              <input type="text" value="" data-slug />
              <small data-slug-preview>URL appears after the editor connects.</small>
            </label>

            <label>
              <span>Excerpt</span>
              <textarea rows="6" data-excerpt></textarea>
            </label>

            <label>
              <span>Tags</span>
              <input type="text" value="" data-tags />
            </label>

<fieldset class="studio-layout-picker" data-layout-fieldset>
              <legend>Article layout</legend>
              <section class="studio-layout-guidance" data-layout-guidance aria-labelledby="layout-guidance-title">
                <strong id="layout-guidance-title">Choose by the reader’s need</strong>
                <ul>
                  <li><b>Classic Reading</b> — scripture commentary, a sustained essay, or an opinion/perspective. Best when the prose and argument should carry the reader without interruption.</li>
                  <li><b>Visual Journey</b> — katha, a life or pilgrimage, or a visual ritual walkthrough. Best when scenes, movement and images guide the experience.</li>
                  <li><b>Study &amp; Reflection</b> — a pūjā or meditation paddhati, practice guidance, or verse-by-verse inquiry. Best when readers need steps, questions or prompts beside the teaching.</li>
                </ul>
                <p>If a ritual is primarily a sequence to practise, choose Study &amp; Reflection; if it is being told as an experience, choose Visual Journey. Unsure? Start with Classic Reading. You can switch and preview before submitting.</p>
              </section>
              <label><input type="radio" name="article-layout" value="classic-reading" data-layout-option checked /><span><i class="layout-diagram layout-diagram-classic" aria-hidden="true"></i><strong>Classic Reading</strong><small>A calm, continuous reading column.</small></span></label>
              <label><input type="radio" name="article-layout" value="visual-journey" data-layout-option /><span><i class="layout-diagram layout-diagram-visual" aria-hidden="true"></i><strong>Visual Journey</strong><small>Spacious chapters with stronger visual pauses.</small></span></label>
              <label><input type="radio" name="article-layout" value="study-reflection" data-layout-option /><span><i class="layout-diagram layout-diagram-study" aria-hidden="true"></i><strong>Study &amp; Reflection</strong><small>A study column with prompts alongside it.</small></span></label>
              <p>Choose a layout, save, then preview it. The public layout changes only when a Publisher or Administrator publishes.</p>
            </fieldset>

            <div class="studio-checks">
              <p class="studio-kicker">Pre-publish check</p>
              <p data-title-check role="status">Add an article title and URL slug before publishing.</p>
              <p><span aria-hidden="true">✓</span> Responsive preview available</p>
              <p><span aria-hidden="true">○</span> Media and link validation next</p>
            </div>

            <div class="studio-revisions">
              <p class="studio-kicker">Cloud revisions</p>
              <ol data-revisions>
                <li>No explicit checkpoints yet</li>
              </ol>
            </div>
          </aside>
        </div>

        <section class="studio-publication-receipt" data-publication-receipt hidden>
          <div>
            <p class="studio-kicker">Published release</p>
            <strong>Your article is live.</strong>
            <a data-publication-live target="_blank" rel="noopener noreferrer"></a>
            <small>Release <code data-publication-release></code></small>
          </div>
          <button class="studio-button studio-button-secondary" type="button" data-receipt-unpublish>Unpublish</button>
        </section>

        <section class="studio-content-library" data-content-library hidden>
          <header class="studio-library-header">
            <div>
              <p class="studio-kicker">Content library</p>
              <h1 data-library-title>My articles</h1>
              <p data-library-summary>Manage articles and drafts.</p>
            </div>
            <button class="studio-button" type="button" data-new-article>＋ New article</button>
          </header>
          <div class="studio-library-filters">
            <label>Search article titles <input type="search" data-article-search placeholder="Search your permitted articles" /></label>
            <label>Collection <select data-article-collection-filter disabled><option value="">All collections</option></select></label>
          </div>
          <div class="studio-library-list" data-library-list></div>
        </section>

        <section class="studio-content-library studio-collections-workspace" data-collection-manager hidden aria-labelledby="collection-manager-title">
          <div class="studio-collections-list-view" data-collections-list-view>
            <header class="studio-library-header">
              <div>
                <p class="studio-kicker">Library structure</p>
                <h1 id="collection-manager-title" tabindex="-1">Collections</h1>
                <p>Organize articles under texts, philosophies, traditions, practices and themes.</p>
              </div>
              <button class="studio-button" type="button" data-new-collection>＋ New collection</button>
            </header>

            <div class="studio-collection-summary" data-thread-metrics aria-live="polite">
              <p>Loading collection totals…</p>
            </div>

            <div class="studio-library-filters studio-collection-filters">
              <label>Search collections <input type="search" data-collection-search placeholder="Search by name or URL" /></label>
              <details class="studio-collection-filter-options" data-collection-filter-options open>
                <summary>Filter and sort</summary>
                <div>
              <label>Type
                <select data-collection-type-filter aria-label="Filter collection type">
                  <option value="">All types</option>
                  <option value="text">Text</option>
                  <option value="philosophy">Philosophy</option>
                  <option value="tradition">Tradition</option>
                  <option value="practice">Practice</option>
                  <option value="theme">Theme</option>
                </select>
              </label>
              <label>Order
                <select data-collection-sort aria-label="Sort collections">
                  <option value="order">Display order</option>
                  <option value="title">Title A–Z</option>
                  <option value="type">Collection type</option>
                </select>
              </label>
                </div>
              </details>
            </div>

            <div class="studio-collection-list" data-collection-management-list></div>
          </div>

          <div class="studio-collection-editor" data-collection-editor hidden>
            <button class="studio-back-link" type="button" data-close-collection-editor>← Back to collections</button>
            <header class="studio-collection-editor-header">
              <p class="studio-kicker">Administrator only</p>
              <h1 data-collection-editor-title tabindex="-1">New collection</h1>
              <p>Create the public home that will hold a related body of articles.</p>
            </header>

            <form class="studio-collection-form" data-collection-form>
              <fieldset>
                <legend>Basics</legend>
                <label><span>Collection title</span><input name="title" type="text" maxlength="120" required /></label>
                <label><span>Short introduction</span><input name="subtitle" type="text" maxlength="200" required /><small>One clear sentence shown on collection cards.</small></label>
                <label><span>Collection description</span><textarea name="description" rows="5" maxlength="1000" required></textarea><small>Describe what readers will find and why the collection matters.</small></label>
                <label><span>Collection type</span>
                  <select name="type" aria-describedby="collection-type-help" required>
                    <option value="text">Text</option>
                    <option value="philosophy">Philosophy</option>
                    <option value="tradition">Tradition</option>
                    <option value="practice">Practice</option>
                    <option value="theme" selected>Theme</option>
                  </select>
                  <small id="collection-type-help">Text: a book or source text · Philosophy: a system of ideas or inquiry · Tradition: a lineage or established school · Practice: methods, skills or routines · Theme: a shared subject or question.</small>
                </label>
              </fieldset>

              <fieldset>
                <legend>Public address and placement</legend>
                <label><span>URL slug</span><input name="id" type="text" maxlength="80" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required /><small data-collection-url-preview>/topics/your-collection</small></label>
                <label><span>Display order</span><input name="order" type="number" min="0" max="10000" value="50" required /><small>Lower numbers appear first.</small></label>
                <label class="studio-checkbox"><input name="featured" type="checkbox" /><span>Feature in collection navigation</span></label>
              </fieldset>

              <fieldset>
                <legend>Collection artwork</legend>
                <label><span>Upload an image</span><input type="file" accept="image/png,image/jpeg,image/webp" data-collection-image-upload /><small>PNG, JPEG or WebP, up to 5 MB. A landscape image works best. Uploaded when you save the collection.</small></label>
                <p data-collection-upload-status role="status" aria-live="polite" hidden></p>
                <button class="studio-button studio-button-secondary" type="button" data-clear-collection-upload hidden>Cancel image upload</button>
                <label><span>Or choose an existing image</span><select name="image"><option value="">No image</option></select></label>
                <label><span>Image description</span><input name="imageAlt" type="text" maxlength="500" /><small>Required when an image is selected.</small></label>
                <div class="studio-collection-image-preview" data-collection-image-preview hidden><img alt="" /><span></span></div>
              </fieldset>

              <input name="family" type="hidden" />
              <div class="studio-collection-form-actions">
                <button class="studio-button" type="submit" data-save-collection>Publish collection</button>
                <button class="studio-button studio-button-secondary" type="button" data-cancel-collection>Cancel</button>
              </div>
              <p class="studio-collection-form-note">Saving publishes collection details immediately. Existing article pages are not changed.</p>
            </form>
          </div>

          <p class="studio-collection-status" role="status" aria-live="polite" data-collection-status></p>
        </section>
      </section>
    </main>

    <dialog class="studio-dialog studio-preview-dialog" data-preview-dialog>
      <div class="studio-dialog-header">
        <div>
          <p class="studio-kicker">Saved article and layout preview</p>
          <h2>Preview</h2>
        </div>
        <div class="studio-dialog-actions">
          <div class="studio-device-toggle" role="group" aria-label="Preview width">
            <button class="is-active" type="button" data-device="desktop">Desktop</button>
