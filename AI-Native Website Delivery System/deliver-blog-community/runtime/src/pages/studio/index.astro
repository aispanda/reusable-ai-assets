        <div class="studio-publish-summary">
          <div><span>Title</span><strong data-review-title></strong></div>
          <div><span>Destination</span><strong data-review-url></strong></div>
          <div><span>Timing</span><strong>Right now</strong></div>
          <div><span>Delivery</span><strong>Web only</strong></div>
